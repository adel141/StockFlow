@model SmartInventory.Model.OperationsDto.DashboardDto
@{ViewData["Title"]="Dashboard";}
<div class="page-heading"><div><h3>Dashboard</h3><p>Inventory and business overview.</p></div></div>
<div class="row g-3 mb-4">
@foreach(var item in new[]{("Products",Model.ProductCount,"/Products"),("Categories",Model.CategoryCount,"/Categories"),("Suppliers",Model.SupplierCount,"/Suppliers"),("Customers",Model.CustomerCount,"/Customers"),("Warehouses",Model.WarehouseCount,"/Warehouses"),("Low Stock",Model.LowStockCount,"/Inventory")}){<div class="col-md-4 col-xl-2"><a href="@item.Item3" class="text-decoration-none"><div class="content-card h-100"><p class="text-muted mb-1">@item.Item1</p><h3>@item.Item2</h3></div></a></div>}
</div>
<div class="row g-3"><div class="col-lg-6"><div class="content-card"><h5>Purchase Total</h5><h3>৳ @Model.PurchaseTotal.ToString("N2")</h3></div></div><div class="col-lg-6"><div class="content-card"><h5>Sales Total</h5><h3>৳ @Model.SalesTotal.ToString("N2")</h3></div></div><div class="col-lg-6"><div class="content-card"><h5>Low Stock Products</h5><table class="table"><thead><tr><th>Product</th><th>Warehouse</th><th>Qty</th><th>Reorder</th></tr></thead><tbody>@foreach(var x in Model.LowStock){<tr><td>@x.ProductName</td><td>@x.WarehouseName</td><td>@x.Quantity</td><td>@x.ReorderLevel</td></tr>}</tbody></table><a asp-controller="Inventory" asp-action="Index">View inventory</a></div></div><div class="col-lg-6"><div class="content-card"><h5>Recent Stock Transactions</h5><table class="table"><thead><tr><th>Date</th><th>Product</th><th>Type</th><th>Qty</th></tr></thead><tbody>@foreach(var x in Model.RecentTransactions){<tr><td>@x.Date.ToString("dd MMM")</td><td>@x.ProductName</td><td>@x.Type</td><td>@x.Quantity</td></tr>}</tbody></table><a asp-controller="Transactions" asp-action="Index">View all transactions</a></div></div></div>
