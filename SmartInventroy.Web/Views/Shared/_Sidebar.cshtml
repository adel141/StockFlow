@{
    // Normalize the role name so that "Staff", "Inventory Staff", and
    // "Sales Staff" receive the correct workspace navigation.
    var role = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty)
        .Trim()
        .ToLowerInvariant();

    var isAdmin = role.Contains("admin");
    var isManager = role.Contains("manager");
    var isStaff = role.Contains("staff") || role.Contains("employee") || role.Contains("operator");

    // Managers and general staff can use the normal operational workspace.
    // More specific staff roles retain the matching module permissions.
    var hasGeneralOperationsAccess = isAdmin || isManager || isStaff;
    var canInventory = hasGeneralOperationsAccess || role.Contains("inventory") || role.Contains("warehouse") || role.Contains("stock") || role.Contains("store");
    var canPurchase = hasGeneralOperationsAccess || role.Contains("purchase") || role.Contains("procurement");
    var canSales = hasGeneralOperationsAccess || role.Contains("sales");
    var canViewReports = isAdmin || isManager || isStaff || role.Contains("report") || role.Contains("viewer");

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<aside class="sidebar" id="appSidebar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <span class="brand-icon"><i class="bi bi-box-seam"></i></span>
        <span>StockFlow</span>
    </a>

    <div class="sidebar-content">
        <div class="nav-caption">WORKSPACE</div>
        <nav class="sidebar-nav" aria-label="Workspace navigation">
            <a asp-controller="Home" asp-action="Index" class="side-link @(currentController == "Home" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
            </a>

            @if (canInventory || canPurchase || canSales)
            {
                <a asp-controller="Products" asp-action="Index" class="side-link @(currentController == "Products" ? "active" : "")">
                    <i class="bi bi-box"></i><span>Products</span>
                </a>
                <a asp-controller="Categories" asp-action="Index" class="side-link @(currentController == "Categories" ? "active" : "")">
                    <i class="bi bi-tags"></i><span>Categories</span>
                </a>
                <a asp-controller="Warehouses" asp-action="Index" class="side-link @(currentController == "Warehouses" ? "active" : "")">
                    <i class="bi bi-building"></i><span>Warehouses</span>
                </a>
            }

            @if (canPurchase)
            {
                <a asp-controller="Suppliers" asp-action="Index" class="side-link @(currentController == "Suppliers" ? "active" : "")">
                    <i class="bi bi-truck"></i><span>Suppliers</span>
                </a>
            }
            @if (canSales)
            {
                <a asp-controller="Customers" asp-action="Index" class="side-link @(currentController == "Customers" ? "active" : "")">
                    <i class="bi bi-people"></i><span>Customers</span>
                </a>
            }
        </nav>

        <div class="nav-caption">OPERATIONS</div>
        <nav class="sidebar-nav" aria-label="Operations navigation">
            @if (canPurchase)
            {
                <a asp-controller="Purchases" asp-action="Index" class="side-link @(currentController == "Purchases" ? "active" : "")">
                    <i class="bi bi-cart-plus"></i><span>Purchases</span>
                </a>
            }
            @if (canSales)
            {
                <a asp-controller="Sales" asp-action="Index" class="side-link @(currentController == "Sales" ? "active" : "")">
                    <i class="bi bi-receipt"></i><span>Sales</span>
                </a>
            }
            @if (canInventory)
            {
                <a asp-controller="Inventory" asp-action="Index" class="side-link @(currentController == "Inventory" ? "active" : "")">
                    <i class="bi bi-boxes"></i><span>Inventory</span>
                </a>
                <a asp-controller="Transactions" asp-action="Index" class="side-link @(currentController == "Transactions" ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i><span>Transactions</span>
                </a>
            }
        </nav>

        @if (canViewReports)
        {
            <div class="nav-caption">INSIGHTS</div>
            <nav class="sidebar-nav" aria-label="Insights navigation">
                <a asp-controller="Reports" asp-action="Index" class="side-link @(currentController == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i><span>Reports</span>
                </a>
            </nav>
        }

        @if (isAdmin)
        {
            <div class="nav-caption">ADMINISTRATION</div>
            <nav class="sidebar-nav" aria-label="Administration navigation">
                <a asp-controller="Users" asp-action="Index" class="side-link @(currentController == "Users" ? "active" : "")">
                    <i class="bi bi-person-gear"></i><span>User Management</span>
                </a>
                <a asp-controller="Settings" asp-action="Index" class="side-link @(currentController == "Settings" ? "active" : "")">
                    <i class="bi bi-gear"></i><span>Settings</span>
                </a>
            </nav>
        }
    </div>

    <div class="sidebar-bottom">
        <div class="user-avatar">@((User.Identity?.Name ?? "U").Substring(0, 1).ToUpperInvariant())</div>
        <div class="sidebar-user">
            <strong>@(User.Identity?.Name ?? "User")</strong>
            <small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")</small>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form">
            <button type="submit" class="sidebar-logout" title="Sign out" aria-label="Sign out">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </form>
    </div>
</aside>
