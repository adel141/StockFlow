@{
    ViewData["Title"] = "Add Warehouse";
}

<div class="page-heading">
    <div><h3>Add Warehouse</h3><p>Create a new inventory storage location.</p></div>
    <a asp-action="Index" class="btn btn-light">Back</a>
</div>

<div class="content-card">
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Warehouse Name</label>
                <input class="form-control" placeholder="Enter warehouse name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Warehouse Code</label>
                <input class="form-control" placeholder="WH-003" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Manager Name</label>
                <input class="form-control" placeholder="Enter manager name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input class="form-control" placeholder="Contact number" />
            </div>
            <div class="col-md-6">
                <label class="form-label">City</label>
                <input class="form-control" placeholder="City" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Capacity</label>
                <input type="number" class="form-control" placeholder="Maximum capacity" />
            </div>
            <div class="col-12">
                <label class="form-label">Full Address</label>
                <textarea class="form-control" rows="3" placeholder="Warehouse address"></textarea>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button class="btn btn-primary">Save Warehouse</button>
        </div>
    </form>
</div>
