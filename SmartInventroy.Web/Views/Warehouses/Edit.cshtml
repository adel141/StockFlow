@{
    ViewData["Title"] = "Edit Warehouse";
}

<div class="page-heading">
    <div><h3>Edit Warehouse</h3><p>Update warehouse details.</p></div>
    <a asp-action="Index" class="btn btn-light">Back</a>
</div>

<div class="content-card">
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Warehouse Name</label>
                <input class="form-control" value="Main Warehouse" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Warehouse Code</label>
                <input class="form-control" value="WH-001" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Manager Name</label>
                <input class="form-control" value="Rahim Ahmed" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input class="form-control" value="01700000001" />
            </div>
            <div class="col-md-6">
                <label class="form-label">City</label>
                <input class="form-control" value="Dhaka" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Capacity</label>
                <input type="number" class="form-control" value="2000" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select class="form-select">
                    <option selected>Active</option>
                    <option>Inactive</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Full Address</label>
                <textarea class="form-control" rows="3">Dhaka, Bangladesh</textarea>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button class="btn btn-primary">Update Warehouse</button>
        </div>
    </form>
</div>
