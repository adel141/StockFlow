@model SmartInventory.Model.OperationsDto.UserDto
@{ ViewData["Title"] = "User Details"; }

<div class="page-heading">
    <div><h3>User Details</h3><p>Review the complete record information.</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>
<div class="content-card detail-card">
    <div class="row g-4">
        <div class="col-md-6">
            <small class="text-muted">Full Name</small>
            <div class="detail-value">@Model.FullName</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Username</small>
            <div class="detail-value">@Model.Username</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Email</small>
            <div class="detail-value">@(Model.Email ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Role</small>
            <div class="detail-value">@Model.RoleName</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Status</small>
            <div class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</div>
        </div>
    </div>
</div>
