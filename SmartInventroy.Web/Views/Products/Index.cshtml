@model IEnumerable<SmartInventory.Model.ProductDto.ProductListModel>
@{
    ViewData["Title"] = "Products";
}
<div class="page-heading">
    <div>
<h3>Products</h3>
<p>Manage your inventory products and their information.</p>
</div>
    <a asp-action="Create" class="btn btn-primary">
<i class="bi bi-plus-lg">
</i> Add Product</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="content-card">
    <form method="get" asp-action="Index" class="row mb-3 g-2">
        <div class="col-md-4">
<input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, SKU or barcode..." />
</div>
        <div class="col-md-3">
<select name="categoryId" class="form-select">
<option value="">All Categories</option>@foreach(var c in (IEnumerable<SmartInventory.Model.CrudDto.CategoryDto>)ViewBag.Categories){<option value="@c.CategoryId" selected="@(ViewBag.CategoryId == c.CategoryId)">@c.CategoryName</option>}</select>
</div>
        <div class="col-md-3">
<select name="status" class="form-select">
<option value="">All Status</option>
<option value="active" selected="@(ViewBag.Status == "active")">Active</option>
<option value="inactive" selected="@(ViewBag.Status == "inactive")">Inactive</option>
</select>
</div>
        <div class="col-md-2 d-flex gap-2">
<button class="btn btn-outline-secondary w-100" type="submit">
<i class="bi bi-funnel">
</i> Filter</button>
<a asp-action="Index" class="btn btn-light">Clear</a>
</div>
    </form>
    <div class="table-responsive">
<table class="js-data-table table align-middle">
<thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>Status</th>
<th>SKU</th>
<th>Barcode</th>
<th>Purchase Price</th>
<th>Selling Price</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
    @foreach(var product in Model){<tr>
<td>@product.ProductId</td>
<td>@product.ProductName</td>
<td>@if(product.IsActive){<span class="badge bg-success">Active</span>}else{<span class="badge bg-secondary">Inactive</span>}</td>
<td>@product.Sku</td>
<td>@product.Barcode</td>
<td>৳ @product.PurchasePrice.ToString("N2")</td>
<td>৳ @product.SellingPrice.ToString("N2")</td>
<td class="text-nowrap">
<a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-info btn-sm">Details</a> <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-warning btn-sm">Edit</a> <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-danger btn-sm">Delete</a>
</td>
</tr>}
    @if(!Model.Any()){<tr>
<td colspan="8" class="text-center text-muted">No products found.</td>
</tr>}
    </tbody>
</table>
</div>
</div>
