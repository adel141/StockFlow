@{
    ViewData["Title"] = "Products";
}

<div class="page-heading">
    <div>
        <h3>Products</h3>
        <p>Manage your inventory products and their information.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Product
    </a>
</div>

<div class="content-card">
    <div class="row mb-3 g-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search products..." />
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>All Categories</option>
                <option>Electronics</option>
                <option>Accessories</option>
                <option>Furniture</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>All Status</option>
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-secondary w-100">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Wireless Mouse</strong></td>
                    <td>PRD-001</td>
                    <td>Accessories</td>
                    <td>৳850</td>
                    <td>120</td>
                    <td><span class="status success">Active</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="1" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="1" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="1" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
                <tr>
                    <td><strong>Mechanical Keyboard</strong></td>
                    <td>PRD-002</td>
                    <td>Accessories</td>
                    <td>৳3,500</td>
                    <td>45</td>
                    <td><span class="status success">Active</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="2" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="2" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="2" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
                <tr>
                    <td><strong>LED Monitor 24"</strong></td>
                    <td>PRD-003</td>
                    <td>Electronics</td>
                    <td>৳18,500</td>
                    <td>8</td>
                    <td><span class="status warning">Low Stock</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="3" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="3" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="3" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">Showing 3 of 1,284 products</small>
        <div>
            <button class="btn btn-sm btn-outline-secondary">Previous</button>
            <button class="btn btn-sm btn-primary">1</button>
            <button class="btn btn-sm btn-outline-secondary">2</button>
            <button class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </div>
</div>
