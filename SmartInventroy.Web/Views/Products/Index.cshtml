@{
    ViewData["Title"] = "Products";
}

<div class="page-heading">
    <div>
        <h3>Products</h3>
        <p>Manage your inventory products and their information.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Product
    </a>
</div>

<div class="content-card">
    <div class="row mb-3 g-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search products..." />
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>All Categories</option>
                <option>Electronics</option>
                <option>Accessories</option>
                <option>Furniture</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>All Status</option>
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-secondary w-100">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Barcode</th>
                        <th>Purchase Price</th>
                        <th>Selling Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>@product.ProductName</td>
                            <td>@product.Sku</td>
                            <td>@product.Barcode</td>
                            <td>@product.PurchasePrice</td>
                            <td>@product.SellingPrice</td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-info btn-sm">Details</a>

                                <a asp-action="Edit"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-warning btn-sm">Edit</a>

                                <a href="details/@product.ProductId"
                                   class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

    </div>
    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">Showing 3 of 1,284 products</small>
        <div>
            <button class="btn btn-sm btn-outline-secondary">Previous</button>
            <button class="btn btn-sm btn-primary">1</button>
            <button class="btn btn-sm btn-outline-secondary">2</button>
            <button class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </div>
</div>
