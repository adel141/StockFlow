@{
    ViewData["Title"] = "Edit Product";
}

<div class="page-heading">
    <div>
        <h3>Edit Product</h3>
        <p>Update product information and pricing.</p>
    </div>
    <a asp-action="Index" class="btn btn-light">Back to Products</a>
</div>

<div class="content-card">
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Product Name</label>
                <input class="form-control" value="Wireless Mouse" />
            </div>
            <div class="col-md-6">
                <label class="form-label">SKU</label>
                <input class="form-control" value="PRD-001" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Category</label>
                <select class="form-select">
                    <option>Accessories</option>
                    <option>Electronics</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Supplier</label>
                <select class="form-select">
                    <option>Tech Distribution Ltd.</option>
                    <option>Global Electronics</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Purchase Price (৳)</label>
                <input type="number" class="form-control" value="600" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Selling Price (৳)</label>
                <input type="number" class="form-control" value="850" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Minimum Stock</label>
                <input type="number" class="form-control" value="15" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Unit</label>
                <select class="form-select">
                    <option>Piece</option>
                    <option>Box</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select class="form-select">
                    <option>Active</option>
                    <option>Inactive</option>
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn btn-primary">Update Product</button>
        </div>
    </form>
</div>
