@{
    ViewData["Title"] = "Settings";
}

<div class="page-heading">
    <div><h3>System Settings</h3><p>Configure your inventory management workspace.</p></div>
</div>

<div class="content-card mb-4">
    <h5 class="mb-3"><i class="bi bi-building me-2"></i>Company Information</h5>
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Company Name</label>
                <input class="form-control" value="StockFlow Ltd." />
            </div>
            <div class="col-md-6">
                <label class="form-label">Company Email</label>
                <input class="form-control" value="info@example.com" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input class="form-control" value="01700000000" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Website</label>
                <input class="form-control" placeholder="https://example.com" />
            </div>
            <div class="col-12">
                <label class="form-label">Company Address</label>
                <textarea class="form-control" rows="2">Dhaka, Bangladesh</textarea>
            </div>
        </div>
    </form>
</div>

<div class="content-card mb-4">
    <h5 class="mb-3"><i class="bi bi-sliders me-2"></i>General Preferences</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Currency</label>
            <select class="form-select">
                <option>BDT (৳)</option>
                <option>USD ($)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Date Format</label>
            <select class="form-select">
                <option>DD/MM/YYYY</option>
                <option>MM/DD/YYYY</option>
                <option>YYYY-MM-DD</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Default Warehouse</label>
            <select class="form-select">
                <option>Main Warehouse</option>
                <option>Chattogram Warehouse</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Low Stock Notification</label>
            <select class="form-select">
                <option>Enabled</option>
                <option>Disabled</option>
            </select>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary">Save Settings</button>
</div>
