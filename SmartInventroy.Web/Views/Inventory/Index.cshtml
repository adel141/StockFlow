@model List<SmartInventory.Model.OperationsDto.StockRowDto>
@{ViewData["Title"]="Inventory";}
<div class="page-heading"><div><h3>Inventory</h3><p>Current stock by product and warehouse.</p></div><a asp-action="Adjust" class="btn btn-primary">Adjust Stock</a></div>
<div class="content-card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Product</th><th>SKU</th><th>Warehouse</th><th>Quantity</th><th>Reorder Level</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ProductName</td><td>@x.Sku</td><td>@x.WarehouseName</td><td>@x.Quantity</td><td>@x.ReorderLevel</td><td>@(x.IsLowStock?"Low Stock":"Available")</td></tr>}</tbody></table></div></div>
