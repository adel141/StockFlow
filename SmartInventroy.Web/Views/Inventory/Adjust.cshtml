@model SmartInventroy.Web.Models.Operations.StockAdjustmentViewModel
@{ViewData["Title"]="Adjust Stock";}
<div class="page-heading">
<div>
<h3>Adjust Stock</h3>
<p>Record a manual stock increase or decrease.</p>
</div>
<a asp-action="Index" class="btn btn-light">Back</a>
</div>
<div class="content-card">
<form asp-action="Adjust" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger">
</div>
<div class="row g-3">
<div class="col-md-6">
<label asp-for="ProductId" class="form-label">Product</label>
<select asp-for="ProductId" asp-items="Model.Products" class="form-select">
<option value="">Select product</option>
</select>
<span asp-validation-for="ProductId" class="text-danger">
</span>
</div>
<div class="col-md-6">
<label asp-for="WarehouseId" class="form-label">Warehouse</label>
<select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
<option value="">Select warehouse</option>
</select>
</div>
<div class="col-md-6">
<label asp-for="Type" class="form-label">Adjustment</label>
<select asp-for="Type" class="form-select">
<option value="AdjustmentIn">Stock In</option>
<option value="AdjustmentOut">Stock Out</option>
</select>
</div>
<div class="col-md-6">
<label asp-for="Quantity" class="form-label">Quantity</label>
<input asp-for="Quantity" class="form-control" min="1" />
</div>
<div class="col-12">
<label asp-for="Notes" class="form-label">Notes</label>
<textarea asp-for="Notes" class="form-control">
</textarea>
</div>
</div>
<div class="d-flex justify-content-end mt-4">
<button class="btn btn-primary">Save Adjustment</button>
</div>
</form>
</div>
@section Scripts{}
