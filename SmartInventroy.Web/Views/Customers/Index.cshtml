@{
    ViewData["Title"] = "Customers";
}

<div class="page-heading">
    <div><h3>Customers</h3><p>Manage customer records and contact details.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Customer</a>
</div>

<div class="content-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Total Orders</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>ABC Corporation</strong></td>
                    <td>abc@example.com</td>
                    <td>01800000001</td>
                    <td>Dhaka</td>
                    <td>24</td>
                    <td><a asp-action="Edit" asp-route-id="1" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></td>
                </tr>
                <tr>
                    <td><strong>XYZ Enterprise</strong></td>
                    <td>xyz@example.com</td>
                    <td>01800000002</td>
                    <td>Gazipur</td>
                    <td>12</td>
                    <td><a asp-action="Edit" asp-route-id="2" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
