@{
    ViewData["Title"] = "Edit Customer";
}

<div class="page-heading">
    <div><h3>Edit Customer</h3><p>Update customer information.</p></div>
    <a asp-action="Index" class="btn btn-light">Back</a>
</div>

<div class="content-card">
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Customer Name</label>
                <input class="form-control" value="ABC Corporation" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" value="abc@example.com" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input class="form-control" value="01800000001" />
            </div>
            <div class="col-md-6">
                <label class="form-label">City</label>
                <input class="form-control" value="Dhaka" />
            </div>
            <div class="col-12">
                <label class="form-label">Address</label>
                <textarea class="form-control" rows="3">Dhaka, Bangladesh</textarea>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button class="btn btn-primary">Update Customer</button>
        </div>
    </form>
</div>
