@model SmartInventory.Model.CrudDto.CustomerDto
@{ ViewData["Title"] = "Customer Details"; }

<div class="page-heading">
    <div><h3>Customer Details</h3><p>Review the complete record information.</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>
<div class="content-card detail-card">
    <div class="row g-4">
        <div class="col-md-6">
            <small class="text-muted">Customer Name</small>
            <div class="detail-value">@Model.CustomerName</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Phone</small>
            <div class="detail-value">@(Model.Phone ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Email</small>
            <div class="detail-value">@(Model.Email ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Address</small>
            <div class="detail-value">@(Model.Address ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Sales Orders</small>
            <div class="detail-value">@Model.SalesOrderCount</div>
        </div>
    </div>
</div>
