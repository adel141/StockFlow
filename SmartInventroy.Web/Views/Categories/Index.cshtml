@model IEnumerable<SmartInventory.Model.CrudDto.CategoryDto>
@{ ViewData["Title"]="Categories"; }
<div class="page-heading">
<div>
<h3>Categories</h3>
<p>Manage categories records.</p>
</div>
<a asp-action="Create" class="btn btn-primary">Add Category</a>
</div>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<div class="content-card">
<div class="table-responsive">
<table class="js-data-table table align-middle">
<thead>
<tr>
<th>Category Name</th>
<th>Active</th>
<th>Products</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
@foreach(var item in Model){<tr>
<td>@item.CategoryName</td>
<td>@(item.IsActive ? "Active" : "Inactive")</td>
<td>@item.ProductCount</td>
<td>
<a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-info">Details</a> <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-light">Edit</a>
<form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');">
<button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
</form>
</td>
</tr>}
@if(!Model.Any()){<tr>
<td colspan="10" class="text-center text-muted">No records found.</td>
</tr>}
</tbody>
</table>
</div>
</div>
