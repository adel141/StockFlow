@model SmartInventory.Model.CrudDto.CategoryDto
@{ ViewData["Title"] = "Category Details"; }

<div class="page-heading">
    <div><h3>Category Details</h3><p>Review the complete record information.</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>
<div class="content-card detail-card">
    <div class="row g-4">
        <div class="col-md-6">
            <small class="text-muted">Category Name</small>
            <div class="detail-value">@Model.CategoryName</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Description</small>
            <div class="detail-value">@(Model.Description ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Status</small>
            <div class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Products</small>
            <div class="detail-value">@Model.ProductCount</div>
        </div>
    </div>
</div>
