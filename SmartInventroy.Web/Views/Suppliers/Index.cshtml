@model IEnumerable<SmartInventory.Model.CrudDto.SupplierDto>
@{ ViewData["Title"]="Suppliers"; }
<div class="page-heading"><div><h3>Suppliers</h3><p>Manage suppliers records.</p></div><a asp-action="Create" class="btn btn-primary">Add Supplier</a></div>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<div class="content-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Supplier Name</th><th>Contact Person</th><th>Phone</th><th>Email</th><th>Active</th><th>Purchase Orders</th><th>Actions</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.SupplierName</td><td>@item.ContactPerson</td><td>@item.Phone</td><td>@item.Email</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td>@item.PurchaseOrderCount</td><td><a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-light">Edit</a><form asp-action="Delete" asp-route-id="@item.SupplierId" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr>}
@if(!Model.Any()){<tr><td colspan="10" class="text-center text-muted">No records found.</td></tr>}
</tbody></table></div></div>
