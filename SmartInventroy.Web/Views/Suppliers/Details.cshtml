@model SmartInventory.Model.CrudDto.SupplierDto
@{ ViewData["Title"] = "Supplier Details"; }

<div class="page-heading">
    <div><h3>Supplier Details</h3><p>Review the complete record information.</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>
<div class="content-card detail-card">
    <div class="row g-4">
        <div class="col-md-6">
            <small class="text-muted">Supplier Name</small>
            <div class="detail-value">@Model.SupplierName</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Contact Person</small>
            <div class="detail-value">@(Model.ContactPerson ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Phone</small>
            <div class="detail-value">@(Model.Phone ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Email</small>
            <div class="detail-value">@(Model.Email ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Address</small>
            <div class="detail-value">@(Model.Address ?? "—")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Status</small>
            <div class="detail-value">@(Model.IsActive ? "Active" : "Inactive")</div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">Purchase Orders</small>
            <div class="detail-value">@Model.PurchaseOrderCount</div>
        </div>
    </div>
</div>
