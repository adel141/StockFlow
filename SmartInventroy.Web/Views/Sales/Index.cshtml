@model List<SmartInventory.Model.OperationsDto.OrderRowDto>
@{ ViewData["Title"] = "Sales"; }
<div class="page-heading">
    <div><span class="eyebrow">SALES MANAGEMENT</span><h3>Sales orders</h3><p>Customer orders and completed stock deductions.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> New sale</a>
</div>
<div class="content-card order-list-card">
    <div class="order-list-heading"><div><h5>All sales</h5><p>Review customer orders and dispatch details.</p></div><span class="report-count">@Model.Count orders</span></div>
    <div class="table-responsive"><table class="js-data-table table table-hover align-middle mb-0">
        <thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Warehouse</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Action</th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td colspan="7" class="report-empty">No sales orders yet. Create a sale to record a customer order.</td></tr> }
        else { foreach (var x in Model) { <tr>
            <td><strong class="order-number">@x.Number</strong></td><td>@x.Date.ToString("dd MMM yyyy")</td><td>@x.PartyName</td><td>@x.WarehouseName</td>
            <td><span class="order-status">@x.Status</span></td><td class="text-end fw-semibold">৳ @x.Total.ToString("N2")</td>
            <td class="text-end"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i> Details</a></td>
        </tr> } }
        </tbody>
    </table></div>
</div>
