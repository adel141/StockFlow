@model List<SmartInventory.Model.OperationsDto.OrderRowDto>
@{ViewData["Title"]="Sales";}
<div class="page-heading"><div><h3>Sales Orders</h3><p>Completed sales and stock deductions.</p></div><a asp-action="Create" class="btn btn-primary">New Sale</a></div><div class="content-card"><div class="table-responsive"><table class="table"><thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Warehouse</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Number</td><td>@x.Date.ToString("dd MMM yyyy")</td><td>@x.PartyName</td><td>@x.WarehouseName</td><td>@x.Status</td><td>@x.Total.ToString("N2")</td><td><a asp-action="Details" asp-route-id="@x.Id">Details</a></td></tr>}</tbody></table></div></div>
