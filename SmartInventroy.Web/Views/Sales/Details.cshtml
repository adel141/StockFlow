@model SmartInventory.Model.OperationsDto.OrderDetailsDto
@{ViewData["Title"]="Order Details";}
<div class="page-heading"><div><h3>@Model.Number</h3><p>@Model.PartyName · @Model.WarehouseName · @Model.Date.ToString("dd MMM yyyy")</p></div><a asp-action="Index" class="btn btn-light">Back</a></div>
<div class="content-card"><div class="d-flex justify-content-between"><strong>Status: @Model.Status</strong><strong>Total: ৳ @Model.Total.ToString("N2")</strong></div><hr/><table class="table"><thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th><th>Subtotal</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.ProductName</td><td>@x.Quantity</td><td>@x.UnitPrice.ToString("N2")</td><td>@x.SubTotal.ToString("N2")</td></tr>}</tbody></table><p>@Model.Notes</p></div>
