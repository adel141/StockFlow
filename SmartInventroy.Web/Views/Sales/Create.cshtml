@{
    ViewData["Title"] = "Create Sale";
}

<div class="page-heading">
    <div><h3>Create Sales Order</h3><p>Record a new sale for a customer.</p></div>
    <a asp-action="Index" class="btn btn-light">Back</a>
</div>

<div class="content-card">
    <form>
        <h5 class="mb-3">Order Information</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Customer</label>
                <select class="form-select">
                    <option>Select customer</option>
                    <option>ABC Corporation</option>
                    <option>XYZ Enterprise</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Warehouse</label>
                <select class="form-select">
                    <option>Main Warehouse</option>
                    <option>Chattogram Warehouse</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Order Date</label>
                <input type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Payment Method</label>
                <select class="form-select">
                    <option>Cash</option>
                    <option>Bank Transfer</option>
                    <option>Mobile Banking</option>
                    <option>Credit</option>
                </select>
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3">Sale Items</h5>

        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Product</th><th>Available Stock</th><th>Quantity</th><th>Unit Price</th><th>Total</th></tr></thead>
                <tbody>
                    <tr>
                        <td>
                            <select class="form-select">
                                <option>Select product</option>
                                <option>Wireless Mouse</option>
                                <option>Mechanical Keyboard</option>
                            </select>
                        </td>
                        <td>120</td>
                        <td><input type="number" class="form-control" value="2" /></td>
                        <td><input type="number" class="form-control" value="850" /></td>
                        <td>৳1,700</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="d-flex justify-content-between"><span>Subtotal</span><strong>৳1,700</strong></div>
                <div class="d-flex justify-content-between mt-2"><span>Discount</span><strong>৳0</strong></div>
                <hr />
                <div class="d-flex justify-content-between"><strong>Total</strong><h5>৳1,700</h5></div>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label">Notes</label>
            <textarea class="form-control" rows="2"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button class="btn btn-primary">Create Sales Order</button>
        </div>
    </form>
</div>
