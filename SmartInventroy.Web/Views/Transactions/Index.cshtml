@model List<SmartInventory.Model.OperationsDto.TransactionRowDto>
@{ViewData["Title"]="Stock Transactions";}
<div class="page-heading"><div><h3>Stock Transactions</h3><p>Complete history of inventory movements.</p></div><a asp-controller="Inventory" asp-action="Adjust" class="btn btn-primary">Adjust Stock</a></div>
<div class="content-card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Date</th><th>Product</th><th>Warehouse</th><th>Type</th><th>Quantity</th><th>Reference</th><th>Notes</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Date.ToString("dd MMM yyyy HH:mm")</td><td>@x.ProductName</td><td>@x.WarehouseName</td><td>@x.Type</td><td>@x.Quantity</td><td>@x.Reference</td><td>@x.Notes</td></tr>}</tbody></table></div></div>
