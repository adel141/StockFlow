@{
    ViewData["Title"] = "Reports";
}

<div class="page-heading">
    <div><h3>Reports & Analytics</h3><p>Review inventory and business performance.</p></div>
    <button class="btn btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer"></i> Print Report
    </button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card"><p>Total Sales</p><h3>৳4.25M</h3><small>This month</small></div>
    </div>
    <div class="col-md-3">
        <div class="stat-card"><p>Total Purchases</p><h3>৳2.18M</h3><small>This month</small></div>
    </div>
    <div class="col-md-3">
        <div class="stat-card"><p>Products Sold</p><h3>1,420</h3><small>This month</small></div>
    </div>
    <div class="col-md-3">
        <div class="stat-card"><p>Low Stock Items</p><h3>76</h3><small>Current inventory</small></div>
    </div>
</div>

<div class="content-card mb-4">
    <h5 class="mb-3">Generate Report</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Report Type</label>
            <select class="form-select">
                <option>Inventory Report</option>
                <option>Sales Report</option>
                <option>Purchase Report</option>
                <option>Stock Movement Report</option>
                <option>Low Stock Report</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100">Generate</button>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-heading">
        <div><h5>Popular Products</h5><p>Sample sales performance data</p></div>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Product</th><th>Units Sold</th><th>Revenue</th><th>Stock Remaining</th></tr></thead>
            <tbody>
                <tr><td>Wireless Mouse</td><td>320</td><td>৳272,000</td><td>120</td></tr>
                <tr><td>Mechanical Keyboard</td><td>185</td><td>৳647,500</td><td>45</td></tr>
                <tr><td>LED Monitor 24"</td><td>90</td><td>৳1,665,000</td><td>8</td></tr>
            </tbody>
        </table>
    </div>
</div>
