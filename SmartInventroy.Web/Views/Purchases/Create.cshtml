@{
    ViewData["Title"] = "Create Purchase";
}

<div class="page-heading">
    <div><h3>Create Purchase Order</h3><p>Record a new purchase from a supplier.</p></div>
    <a asp-action="Index" class="btn btn-light">Back</a>
</div>

<div class="content-card">
    <form>
        <h5 class="mb-3">Purchase Information</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Supplier</label>
                <select class="form-select">
                    <option>Select supplier</option>
                    <option>Tech Distribution Ltd.</option>
                    <option>Global Electronics</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Warehouse</label>
                <select class="form-select">
                    <option>Select warehouse</option>
                    <option>Main Warehouse</option>
                    <option>Chattogram Warehouse</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Order Date</label>
                <input type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Expected Delivery</label>
                <input type="date" class="form-control" />
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3">Purchase Items</h5>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Cost (৳)</th>
                        <th>Total (৳)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <select class="form-select">
                                <option>Select product</option>
                                <option>Wireless Mouse</option>
                                <option>Mechanical Keyboard</option>
                            </select>
                        </td>
                        <td><input type="number" class="form-control" value="10" /></td>
                        <td><input type="number" class="form-control" value="600" /></td>
                        <td>৳6,000</td>
                    </tr>
                    <tr>
                        <td>
                            <select class="form-select">
                                <option>Select product</option>
                                <option>Wireless Mouse</option>
                                <option>Mechanical Keyboard</option>
                            </select>
                        </td>
                        <td><input type="number" class="form-control" value="5" /></td>
                        <td><input type="number" class="form-control" value="2500" /></td>
                        <td>৳12,500</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal</span><strong>৳18,500</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Additional Cost</span><strong>৳0</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <strong>Total</strong><h5>৳18,500</h5>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label">Notes</label>
            <textarea class="form-control" rows="2"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light">Cancel</a>
            <button class="btn btn-primary">Create Purchase Order</button>
        </div>
    </form>
</div>
