@model SmartInventory.Model.OperationsDto.OrderDetailsDto
@{ ViewData["Title"] = "Purchase Details"; }
<div class="operation-detail-page">
    <div class="page-heading no-print">
        <div><span class="eyebrow">PURCHASE MANAGEMENT</span><h3>Purchase details</h3><p>Review the supplier receipt and item breakdown.</p></div>
        <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a><button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print</button></div>
    </div>
    <div class="operation-document-header print-only"><div class="operation-brand">STOCKFLOW</div><div>Purchase receipt</div></div>
    <section class="content-card operation-hero">
        <div><span class="eyebrow">PURCHASE ORDER</span><h2>@Model.Number</h2><p class="text-muted mb-0">Created on @Model.Date.ToString("dd MMMM yyyy")</p></div>
        <div class="operation-total"><small>Order total</small><strong>৳ @Model.Total.ToString("N2")</strong><span class="operation-status">@Model.Status</span></div>
    </section>
    <section class="operation-info-grid">
        <article class="content-card operation-info"><span><i class="bi bi-truck"></i> Supplier</span><strong>@Model.PartyName</strong><small>Purchase source</small></article>
        <article class="content-card operation-info"><span><i class="bi bi-building"></i> Warehouse</span><strong>@Model.WarehouseName</strong><small>Receiving location</small></article>
        <article class="content-card operation-info"><span><i class="bi bi-calendar3"></i> Order date</span><strong>@Model.Date.ToString("dd MMM yyyy")</strong><small>Recorded date</small></article>
    </section>
    <section class="content-card operation-items-card">
        <div class="report-section-heading"><div><h5>Items received</h5><p>Products and quantities included in this purchase</p></div><span class="report-count">@Model.Items.Count items</span></div>
        <div class="table-responsive"><table class="table align-middle operation-items-table"><thead><tr><th>#</th><th>Product</th><th class="text-end">Quantity</th><th class="text-end">Unit price</th><th class="text-end">Subtotal</th></tr></thead><tbody>
        @{ var itemIndex = 0; }
        @foreach (var item in Model.Items) { itemIndex++; <tr><td class="text-muted">@itemIndex</td><td class="fw-semibold">@item.ProductName</td><td class="text-end">@item.Quantity</td><td class="text-end">৳ @item.UnitPrice.ToString("N2")</td><td class="text-end fw-semibold">৳ @item.SubTotal.ToString("N2")</td></tr> }
        </tbody><tfoot><tr><th colspan="4" class="text-end">Grand total</th><th class="text-end">৳ @Model.Total.ToString("N2")</th></tr></tfoot></table></div>
    </section>
    @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <section class="content-card operation-notes"><h6><i class="bi bi-sticky me-2"></i>Notes</h6><p>@Model.Notes</p></section> }
</div>
